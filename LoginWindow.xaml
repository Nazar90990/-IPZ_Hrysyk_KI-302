<Window x:Class="MessengerClient.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вхід до Messenger" Height="460" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Messenger" FontSize="30" FontWeight="Bold"
                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
        <TextBlock Grid.Row="1" Text="Безпечний обмін текстовими повідомленнями"
                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,22"
                   Foreground="{StaticResource SecondaryTextBrush}" />

        <StackPanel Grid.Row="2">
            <TextBlock Text="Логін" Margin="4,0,4,0" />
            <TextBox x:Name="UsernameTextBox" MaxLength="40" />
            <TextBlock Text="Пароль" Margin="4,12,4,0" />
            <PasswordBox x:Name="PasswordInput" Margin="4" Padding="10,8" />
        </StackPanel>

        <TextBlock x:Name="ErrorTextBlock" Grid.Row="3" Foreground="#C53030"
                   TextWrapping="Wrap" Margin="4,10,4,4" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button x:Name="ActionButton" Content="Увійти" Width="160" Click="ActionButton_Click" />
            <Button Content="Очистити" Width="125" Style="{StaticResource SecondaryButtonStyle}"
                    Click="ClearButton_Click" />
        </StackPanel>

        <Button x:Name="ModeButton" Grid.Row="5" Content="Немає облікового запису? Зареєструватися"
                Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Top"
                Click="ModeButton_Click" />
    </Grid>
</Window>
