<Window x:Class="MessengerClient.NewChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новий чат" Height="400" Width="360" MinHeight="300" MinWidth="300"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Виберіть користувача" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
        <ListBox x:Name="UsersListBox" Grid.Row="1" DisplayMemberPath="Title" MouseDoubleClick="UsersListBox_MouseDoubleClick" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Скасувати" Width="100" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Створити" Width="100" Click="CreateButton_Click" />
        </StackPanel>
    </Grid>
</Window>
