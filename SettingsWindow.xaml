<Window x:Class="MessengerClient.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Налаштування профілю" Height="360" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Налаштування профілю" FontSize="24" FontWeight="Bold" />
        <TextBlock Grid.Row="1" Text="Зміни відразу відображаються у головному вікні." Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,20" />
        <StackPanel Grid.Row="2">
            <TextBlock Text="Ім’я користувача" Margin="4,0,4,0" />
            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Статус" Margin="4,10,4,0" />
            <ComboBox x:Name="StatusComboBox" SelectedValue="{Binding Status, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Margin="4">
                <ComboBoxItem Content="У мережі" />
                <ComboBoxItem Content="Не турбувати" />
                <ComboBoxItem Content="Невидимий" />
            </ComboBox>
        </StackPanel>
        <TextBlock x:Name="InfoTextBlock" Grid.Row="3" Foreground="{StaticResource AccentBrush}" Margin="4,12,4,0" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Зберегти" Width="110" Click="SaveButton_Click" />
            <Button Content="Скасувати" Width="110" Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
